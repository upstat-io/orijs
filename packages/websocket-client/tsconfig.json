{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"outDir": "dist",
		"lib": ["ES2023", "DOM"],
		"types": ["bun"],
		"allowImportingTsExtensions": true,
		"noEmit": true
	},
	"include": ["src/**/*", "__tests__/**/*"],
	"exclude": ["node_modules"]
}
